# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Demo Mode (1 = enabled, 0 = disabled)
DEMO_MODE=0

# Environment
NODE_ENV=development

# LLM model (Agent B, B1). Pick a current Gemini model; do not use the retired gemini-pro.
GEMINI_MODEL=
# Left empty, Wolfie uses gemini-3.6-flash. gemini-pro is retired and is refused.

# ElevenLabs voice (Agent B, B5)
# Voice id from your ElevenLabs account (required for spoken replies)
ELEVENLABS_VOICE_ID=
# Empty = eleven_flash_v2_5 (low latency)
ELEVENLABS_TTS_MODEL=
# Empty = scribe_v2_realtime
ELEVENLABS_STT_MODEL=

# Optional: separate userData dir so two worktrees can run at once
# WOLFIE_USER_DATA=/tmp/wolfie-a
