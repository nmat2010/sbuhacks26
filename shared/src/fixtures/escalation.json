{
  "scenarios": [
    {
      "name": "single_weak_signal",
      "signals": [
        {
          "type": "idle_on_work",
          "strength": "weak",
          "timestamp": 1000
        }
      ],
      "expected_level": 2
    },
    {
      "name": "strong_signal_reaches_level_3",
      "signals": [
        {
          "type": "wrong_answer_loop",
          "strength": "strong",
          "timestamp": 1000
        }
      ],
      "expected_level": 3,
      "description": "Strong signal can reach level 3"
    },
    {
      "name": "two_weak_signals_reach_level_3",
      "signals": [
        {
          "type": "idle_on_work",
          "strength": "weak",
          "timestamp": 1000
        },
        {
          "type": "validation_errors",
          "strength": "weak",
          "timestamp": 2000
        }
      ],
      "expected_level": 3,
      "description": "Two weak signals together can reach level 3"
    },
    {
      "name": "level_4_requires_voice_mode_and_time",
      "signals": [
        {
          "type": "wrong_answer_loop",
          "strength": "strong",
          "timestamp": 1000
        }
      ],
      "voice_mode": true,
      "wait_time": 60000,
      "expected_level": 4,
      "description": "Level 4 requires voice mode on and 60s wait at level 3"
    },
    {
      "name": "level_4_capped_without_voice",
      "signals": [
        {
          "type": "wrong_answer_loop",
          "strength": "strong",
          "timestamp": 1000
        }
      ],
      "voice_mode": false,
      "wait_time": 60000,
      "expected_level": 3,
      "description": "Without voice mode, max level is 3"
    },
    {
      "name": "decline_starts_cooldown",
      "signals": [
        {
          "type": "wrong_answer_loop",
          "strength": "strong",
          "timestamp": 1000
        }
      ],
      "user_action": "decline",
      "expected_cooldown": 180000,
      "expected_level": 2,
      "description": "Decline starts 3-minute cooldown and lowers intensity"
    },
    {
      "name": "i_am_good_suppresses_for_session",
      "signals": [
        {
          "type": "wrong_answer_loop",
          "strength": "strong",
          "timestamp": 1000
        }
      ],
      "user_action": "i_am_good",
      "expected_level": 0,
      "description": "I'm good suppresses offers for the problem for the session"
    },
    {
      "name": "recent_input_prevents_offer",
      "signals": [
        {
          "type": "wrong_answer_loop",
          "strength": "strong",
          "timestamp": 1000
        }
      ],
      "last_input_time": 500,
      "expected_level": 0,
      "description": "No offer within 5 seconds of recent input"
    }
  ]
}
