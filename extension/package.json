{
  "name": "@wolfie/extension",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-files",
    "copy-files": "cp manifest.json dist/ && cp popup.html dist/ && cp -r icons dist/ 2>/dev/null || true",
    "watch": "tsc --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "@wolfie/shared": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "@types/node": "^20.11.5"
  }
}
